# Enable only after clipper.codekunda.com resolves to this VPS and a certificate exists.
server {
    listen 80;
    server_name clipper.codekunda.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name clipper.codekunda.com;
    ssl_certificate /etc/letsencrypt/live/clipper.codekunda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clipper.codekunda.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    include /etc/nginx/snippets/security-headers.conf;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:3120;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_read_timeout 300s;
    }
}
